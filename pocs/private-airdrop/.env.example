# Copy this file to `.env` and fill in your own values.
# Never commit real private keys.

# Service endpoints - point these at your own Starknet RPC, proving, and indexer.
VITE_RPC_URL=http://localhost:5050/rpc/v0_10
VITE_PROVING_SERVICE_URL=http://localhost:3000
VITE_INDEXER_URL=http://localhost:8080

# Privacy-pool and token addresses (Starknet Sepolia example values).
VITE_POOL_ADDRESS=0x_YOUR_POOL_ADDRESS
VITE_TOKEN_ADDRESS=0x_YOUR_TOKEN_ADDRESS
VITE_FEE_TOKEN_ADDRESS=0x_YOUR_FEE_TOKEN_ADDRESS
VITE_CHAIN_ID=0x534e5f5345504f4c4941
VITE_PROOF_VALIDITY_BLOCKS=450

# Demo accounts. Use throwaway devnet/testnet keys only - NEVER a mainnet key.
ACCOUNTS=[{"name":"Admin","address":"0x_ADMIN_ADDRESS","privateKey":"0x_ADMIN_PRIVATE_KEY","viewingKey":"0x0","salt":"0x_SALT","admin":true},{"name":"Alice","address":"0x_ALICE_ADDRESS","privateKey":"0x_ALICE_PRIVATE_KEY","viewingKey":"0xA11CE","salt":"0x_SALT"},{"name":"Bob","address":"0x_BOB_ADDRESS","privateKey":"0x_BOB_PRIVATE_KEY","viewingKey":"0xB0B","salt":"0x_SALT"}]

# Recipients for the demo airdrop.
VITE_AIRDROP_RECIPIENTS=[{"address":"0x_ALICE_ADDRESS","amount":"500"},{"address":"0x_BOB_ADDRESS","amount":"300"}]
